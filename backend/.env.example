# Server Configuration
PROJECT_NAME="Xpanse Collaboration API"
HOST="0.0.0.0"
PORT=8000
DEBUG=True

# Database Configuration
# Primary: PostgreSQL. Example local database setup:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/xpanse
# Fallback / Quickstart Option (can use SQLite for local testing without server):
DATABASE_URL=sqlite:///./xpanse.db

# Security & JWT Configuration
# Generate a secure key using: openssl rand -hex 32
# Required when DEBUG=False; in DEBUG mode a temporary key is used if left as-is.
SECRET_KEY=change-me
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Origins (JSON list of allowed hosts)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:5173"]

# Optional: Sentry for Error Tracking
# SENTRY_DSN=""
